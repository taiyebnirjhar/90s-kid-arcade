<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only to download game pictures (title screens) for the home screen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Two players: finding a hosted game on the local network (Wi-Fi or hotspot). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Keeps Wi-Fi awake during a two-player game (WifiLock). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".ArcadeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="90s Kid Arcade"
        android:theme="@style/Theme.Kof">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Kof.Game" />
    </application>
</manifest>
