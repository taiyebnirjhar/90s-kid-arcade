<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Downloading games from your library (Library). Game pictures ship inside the app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Two players: finding a hosted game on the local network (Wi-Fi or hotspot). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Multiplayer stays on the room's Wi-Fi (LanLink). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Keeps Wi-Fi awake during a two-player game (WifiLock). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Voice in internet rooms: asked for only when the player turns their mic on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".ArcadeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="90s Kid Arcade"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Kof">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- An internet room's link (shared, or its QR code): straight to joining it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="taiyebnirjhar.github.io" android:pathPattern="/90s-kid-arcade/join.html" />
            </intent-filter>
            <!-- The website's "Open in the app" button. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kidarcade" android:host="join" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|density|locale|layoutDirection"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Kof.Game" />
    </application>
</manifest>
